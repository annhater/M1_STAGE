@article{barin_prevalence_2007,
	title = {Prevalence of {HIV}-2 and {HIV}-1 group {O} infections among new {HIV} diagnoses in {France}: 2003-2006},
	volume = {21},
	issn = {0269-9370},
	shorttitle = {Prevalence of {HIV}-2 and {HIV}-1 group {O} infections among new {HIV} diagnoses in {France}},
	doi = {10.1097/QAD.0b013e3282f15637},
	abstract = {French national surveillance of new HIV diagnoses included the collection of dried serum spots to identify HIV serotypes. Between January 2003 and June 2006, 10,184 new diagnoses were reported. The proportions of HIV-2 and HIV-1 group O infections were 1.8 and 0.1\%, respectively. Most of these cases occurred in patients infected through heterosexual contact and originated from the corresponding endemic areas. Three cases of HIV-2 infections were reported in non-African men having sex with men.},
	language = {eng},
	number = {17},
	journal = {AIDS},
	author = {Barin, Francis and Cazein, Françoise and Lot, Florence and Pillonel, Josiane and Brunet, Sylvie and Thierry, Damien and Damond, Florence and Brun-Vézinet, Françoise and Desenclos, Jean-Claude and Semaille, Caroline},
